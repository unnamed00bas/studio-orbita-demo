# Базовый URL сайта — нужен для sitemap, OG-картинок, абсолютных ссылок.
NEXT_PUBLIC_SITE_URL=https://studio-orbita.example.com

# AI-консультант (Anthropic Messages API).
# Если ключ не задан — чат отвечает заглушкой и подсказывает, что нужно настроить.
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Модель по умолчанию для AI-консультанта.
# Рекомендуется: claude-opus-4-7 (мощность) или claude-haiku-4-5 (скорость и цена).
ANTHROPIC_MODEL=claude-opus-4-7
